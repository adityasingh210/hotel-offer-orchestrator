{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregates hotel offers from two suppliers with Temporal, dedupes by name, picks the best price, and filters by price range in Redis.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "rm -rf dist && tsc -p tsconfig.json && LOG_LEVEL=silent node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/common": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.26.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

PORT=3000
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=hotel-offers
REDIS_URL=redis://localhost:6379
# Where the worker reaches the mock suppliers (served by the API)
SUPPLIER_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300
PARTIAL_CACHE_TTL_SECONDS=30
LOG_LEVEL=info
# Start a mock supplier in the "down" state
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
